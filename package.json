{
  "name": "@anku/project-memory-kit",
  "version": "0.15.0",
  "description": "Local-first project memory installer for coding agents",
  "license": "MIT",
  "author": "AnKu304",
  "homepage": "https://github.com/AnKu304/project-memory-kit",
  "bugs": {
    "url": "https://github.com/AnKu304/project-memory-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnKu304/project-memory-kit.git"
  },
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "codex",
    "claude",
    "project-memory",
    "rag",
    "sqlite"
  ],
  "bin": {
    "pmem": "./npm/bin/pmem.js",
    "project-memory-kit": "./npm/bin/pmem.js"
  },
  "files": [
    "src/**/*.py",
    "src/**/*.js",
    "src/**/*.json",
    "src/**/*.jsonl",
    "src/**/*.md",
    "src/**/*.sql",
    "src/**/*.yaml",
    "src/project_memory_kit/installer/templates/project-memory.gitignore",
    "src/project_memory_kit/installer/templates/root.gitignore.block",
    "npm/bin/pmem.js",
    "npm/scripts/*.js",
    "docs/npm.md",
    "docs/release-notes/*.md",
    "docs/checklists/*.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "pyproject.toml"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src:src/project_memory_kit/installer/runtime python3 -m unittest discover -s tests",
    "smoke": "node npm/scripts/smoke.js",
    "pack:check": "node npm/scripts/check-pack.js",
    "check": "npm test && npm run smoke && npm run pack:check",
    "prepack": "node npm/scripts/smoke.js"
  }
}
